rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Deny-All fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == "seyhatheng1@gmail.com" && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Orders Collection
    match /orders/{orderId} {
      // Allow customers to place orders with valid payloads
      allow create: if isValidId(orderId) &&
                    incoming().keys().hasAll(['orderId', 'customerName', 'phoneNumber', 'address', 'total']) &&
                    incoming().orderId is string && incoming().orderId.size() <= 64 &&
                    incoming().customerName is string && incoming().customerName.size() <= 100 &&
                    incoming().phoneNumber is string && incoming().phoneNumber.size() <= 30 &&
                    incoming().address is string && incoming().address.size() <= 300 &&
                    incoming().total is number && incoming().total >= 0;
      // Allow customers to look up an individual order by its exact ID for tracking
      allow get: if true;
      // Admin can list, inspect, and update order progress/logs
      allow list, update, delete: if isAdmin();
    }

    // Studio & Workshop Inquiries
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) &&
                    incoming().keys().hasAll(['name', 'emailOrPhone', 'message']) &&
                    incoming().name is string && incoming().name.size() <= 100 &&
                    incoming().emailOrPhone is string && incoming().emailOrPhone.size() <= 150 &&
                    incoming().message is string && incoming().message.size() <= 2000;
      allow read, list, update, delete: if isAdmin();
    }

    // Newsletter Subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) &&
                    incoming().keys().hasAll(['email']) &&
                    incoming().email is string && incoming().email.size() <= 150;
      allow read, list, delete: if isAdmin();
    }

    // Runtime Error Logging
    match /runtime_errors/{errorId} {
      allow create: if isValidId(errorId) &&
                    incoming().keys().hasAll(['message', 'severity']) &&
                    incoming().message is string &&
                    incoming().severity is string;
      allow read, list, delete: if isAdmin();
    }
  }
}
