{
  "entities": {
    "orders": {
      "title": "Studio Order",
      "description": "Customer purchase orders for handcrafted furniture pieces.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique studio order reference (e.g. FUR-849201)"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Customer telephone number"
        },
        "telegramUsername": {
          "type": "string",
          "description": "Optional Telegram username handle"
        },
        "address": {
          "type": "string",
          "description": "Delivery street address"
        },
        "deliveryCity": {
          "type": "string",
          "description": "Destination city (e.g. Phnom Penh)"
        },
        "notes": {
          "type": "string",
          "description": "Custom tailoring or delivery instructions"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Selected payment method"
        },
        "items": {
          "type": "array",
          "description": "Array of ordered furniture items"
        },
        "subtotal": {
          "type": "number",
          "description": "Cart items subtotal in USD"
        },
        "assemblyFee": {
          "type": "number",
          "description": "White-glove assembly fee in USD"
        },
        "discount": {
          "type": "number",
          "description": "Applied discount in USD"
        },
        "shipping": {
          "type": "number",
          "description": "Shipping fee in USD"
        },
        "total": {
          "type": "number",
          "description": "Grand total in USD"
        },
        "promoCode": {
          "type": "string",
          "description": "Applied promo code"
        },
        "orderDate": {
          "type": "string",
          "description": "Formatted date of order placement"
        },
        "currentStage": {
          "type": "number",
          "description": "Workshop pipeline stage index (1-5)"
        },
        "progressPercent": {
          "type": "number",
          "description": "Workshop progress percentage"
        },
        "status": {
          "type": "string",
          "enum": ["Received", "Timber Milling", "Joinery & Sanding", "Hardwax Finishing", "Dispatched", "Delivered"],
          "description": "Current status of handcrafted production"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of order creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of latest update"
        }
      },
      "required": ["orderId", "customerName", "phoneNumber", "address", "total"]
    },
    "inquiries": {
      "title": "Workshop Inquiry",
      "description": "Showroom inquiries, timber swatch requests, and custom commissions.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Inquirer's full name"
        },
        "emailOrPhone": {
          "type": "string",
          "description": "Contact phone, email, or Telegram handle"
        },
        "subject": {
          "type": "string",
          "description": "Subject of inquiry"
        },
        "message": {
          "type": "string",
          "description": "Message content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "emailOrPhone", "message"]
    },
    "newsletter_subscribers": {
      "title": "Newsletter Subscriber",
      "description": "Email subscribers for studio batch announcements and woodworking guides.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscriber email address"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Subscription timestamp"
        }
      },
      "required": ["email"]
    },
    "runtime_errors": {
      "title": "Runtime Error Log",
      "description": "Captured errors from the production frontend for debugging.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "url": { "type": "string" },
        "userAgent": { "type": "string" },
        "component": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "warning", "fatal"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "severity"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Collection of all placed customer orders"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiries",
      "description": "Collection of incoming studio inquiries and swatch requests"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": "newsletter_subscribers",
      "description": "Collection of newsletter subscriber emails"
    },
    "/runtime_errors/{errorId}": {
      "schema": "runtime_errors",
      "description": "Production client error diagnostics log"
    }
  }
}
